#!/usr/bin/env python3
"""jev-gate: one Jev call over a diff -> 14 typed checks -> verdict, before any Claude review.

  git diff main... | jev-gate ["PR description"]     diff on stdin
  jev-gate                                           auto: branch vs merge-base of main/master, else working tree
  jev-gate --hook                                    PreToolUse(Skill) mode: review skill -> verdict as context

Verdicts: BLOCK / ESCALATE / SECURITY-SENIOR REVIEW / NITS / MERGE. A MERGE verdict means a light review is
enough; everything else gets the full review, starting with the flagged checks. Exit 2 = Jev unavailable
(review normally). Credential-looking diffs or descriptions are never sent: they return BLOCK locally.
Policy site "jev-gate" (~/.claude/jev/policy.json sites_off, skip_paths, enabled). A diff longer than LIMIT
is judged on its first LIMIT characters only, so it never gets the MERGE (light review) verdict.
Offline check: jev-gate --test
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.claude/hooks"))
import jev_lib  # noqa: E402

N = {
    "hardcoded_secret": "Does the diff add a hardcoded secret, key, token or password?",
    "injection_risk": "Does the diff add SQL/command/template injection risk (unsanitised input into a query or shell)?",
    "touches_auth": "Does the diff change authentication, authorisation, sessions or permissions?",
    "weakens_tests": "Does the diff delete, skip or loosen existing tests or assertions?",
    "adds_tests": "Does the diff add new tests covering the change?",
    "breaks_api": "Does the diff change a public API, route, signature or response shape in a backward-incompatible way?",
    "data_migration": "Does the diff include a database schema or data migration?",
    "description_matches": "Does the PR description (if any) accurately describe what the diff does?",
    "debug_leftovers": "Does the diff leave debug code (print, console.log, breakpoints, commented-out code)?",
    "docs_only": "Is the diff documentation or comments only?",
    "merge_ready": "Is this diff safe to merge without human review?",
}
S = {"blast_radius": ["isolated change", "one module", "shared code", "core infrastructure"],
     "reviewer_effort": ["glance", "careful read", "domain expert or security reviewer"]}
LIMIT = 60000
C = {"primary_concern": {"none": "no real concern", "auth": "authn/authz/session", "data": "data loss or migration",
                         "injection": "injection or secrets", "api": "API compatibility", "tests": "test coverage"}}


def git(*args, cwd=None):
    r = subprocess.run(["git", *args], capture_output=True, text=True, cwd=cwd)
    return r.stdout if r.returncode == 0 else ""


def auto_diff(cwd=None):
    for base in ("origin/main", "origin/master", "main", "master"):
        mb = git("merge-base", "HEAD", base, cwd=cwd).strip()
        if mb and mb != git("rev-parse", "HEAD", cwd=cwd).strip():
            return git("diff", mb, cwd=cwd)
    return git("diff", "HEAD", cwd=cwd) or git("diff", "HEAD~1", "HEAD", cwd=cwd)  # clean tree: last commit


def gate(diff, desc="", cwd=""):
    """(verdict, summary line) or None when Jev is unavailable or the path is skipped."""
    if not diff.strip():
        return None
    if jev_lib._jev.SECRET.search(diff + "\n" + desc):  # everything that would leave the Mac
        return "BLOCK", "credential-looking string in diff or description (not sent to Jev)"
    pol = jev_lib.policy()
    if not jev_lib._allowed(pol, cwd, "jev-gate"):
        return None
    qs = {k: {"type": "noul", "instructions": v} for k, v in N.items()}
    qs |= {k: {"type": "score", "instructions": f"Rate {k.replace('_', ' ')} of this diff.", "criteria": v}
           for k, v in S.items()}
    qs |= {k: {"type": "choice", "instructions": "What is the main review concern?", "criteria": v} for k, v in C.items()}
    try:
        a = jev_lib._post({"model": jev_lib._jev.MODEL, "state": {"pr_description": desc, "diff": diff[:LIMIT]},
                           "questions": qs}, 15)["answers"]
    except Exception:
        return None
    p = {k: float(a[k]["noul"]) for k in N}
    crit = ["hardcoded_secret", "injection_risk"]
    if any(p[k] >= 0.65 for k in crit):
        v = "BLOCK"
    elif any(0.35 <= p[k] < 0.65 for k in crit):
        v = "ESCALATE"
    elif p["touches_auth"] >= 0.5 or p["breaks_api"] >= 0.5 or p["data_migration"] >= 0.5:
        v = "SECURITY-SENIOR REVIEW"
    elif p["weakens_tests"] >= 0.5 or p["debug_leftovers"] >= 0.5 or p["description_matches"] < 0.5:
        v = "NITS"
    else:
        v = "MERGE"
    if len(diff) > LIMIT and v == "MERGE":  # the unseen tail could hold anything
        v = "NITS"
    flags = [f"{k} {p[k]:.2f}" for k in N if (p[k] >= 0.5) != (k in ("description_matches", "adds_tests", "merge_ready"))]
    summary = (f"concern {a['primary_concern']['choice']}; blast {a['blast_radius']['score']:.1f}/3; "
               f"flags: {', '.join(flags) or 'none'}"
               + (f"; diff truncated to {LIMIT} chars, full review required" if len(diff) > LIMIT else ""))
    jev_lib.log("jev-gate", "PR verdict", summary, p["merge_ready"], v == "MERGE")
    return v, summary


def hook():
    payload = json.loads(sys.stdin.read() or "{}")
    skill = str((payload.get("tool_input") or {}).get("skill", ""))
    if "review" not in skill.lower():
        return
    cwd = payload.get("cwd") or os.getcwd()
    res = gate(auto_diff(cwd), git("log", "-1", "--format=%B", cwd=cwd).strip(), cwd=cwd)
    if not res:
        return
    v, summary = res
    advice = ("light review is enough; skip deep passes" if v == "MERGE"
              else "full review; start with the flagged checks")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                             "additionalContext": f"jev-gate verdict: {v} ({summary}) -> {advice}."}}))


def test():
    """Offline: policy site, payload credential check, truncation. No network, no log writes."""
    sent = []
    clean = {**{k: {"noul": 0.1} for k in N}, "description_matches": {"noul": 0.9},
             "merge_ready": {"noul": 0.9}, "blast_radius": {"score": 0.0}, "reviewer_effort": {"score": 0.0},
             "primary_concern": {"choice": "none"}}
    jev_lib._post = lambda body, timeout: sent.append(body) or {"answers": clean}
    jev_lib.log = lambda *a, **k: None
    pol = {**jev_lib.DEFAULTS}
    jev_lib.policy = lambda: pol
    diff = "+print('hello')\n"
    assert gate(diff, "small change", "/")[0] == "MERGE" and len(sent) == 1
    pol["sites_off"] = ["jev-gate"]
    assert gate(diff, "", "/") is None and len(sent) == 1, "jev-gate in sites_off must not send"
    pol["sites_off"] = []
    secret = "pass" + "word=" + "Zx9" * 4
    assert gate(diff, "rotate creds, " + secret, "/")[0] == "BLOCK" and len(sent) == 1, "secret in description sent"
    v, summary = gate(diff * (LIMIT // len(diff) + 10), "", "/")
    assert v != "MERGE" and "truncated" in summary and len(sent[-1]["state"]["diff"]) == LIMIT
    print("jev-gate test ok")


def main():
    if "--test" in sys.argv:
        return test()
    if "--hook" in sys.argv:
        try:
            hook()
        except Exception:
            pass
        return
    diff = sys.stdin.read() if not sys.stdin.isatty() else auto_diff()
    desc = next((a for a in sys.argv[1:] if not a.startswith("-")), "")
    res = gate(diff, desc, os.getcwd())
    if not res:
        sys.exit("jev-gate: no diff, path skipped or Jev unavailable -> review normally" if diff.strip() else
                 "jev-gate: empty diff")
    print(f"VERDICT: {res[0]} | {res[1]}")


if __name__ == "__main__":
    main()
