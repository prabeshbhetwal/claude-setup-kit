#!/usr/bin/env python3
"""Move files to ~/_trash/<source>/<YYYY-MM-DD>/ instead of deleting them.

  trashmv <path>... [--source NAME]

<source> is fixed per origin so repeat moves land in the same folder:
  - inside a git repo or any of its worktrees -> the main repo's folder name
  - elsewhere under $HOME -> first folder below $HOME, leading dot dropped
    (~/.claude/... -> claude, ~/.cognee-plugin/... -> cognee-plugin)
  - --source NAME overrides both
Same day -> same date folder, and inside it the sub-folders the file came
from (MyApp/Sources/Old/x.swift -> MyApp/<date>/Sources/Old/x.swift). Name clash -> "<name> <HHMMSS>" keeps both.
Each move is logged to ~/_trash/<source>/moves.tsv: time, original, trash path.
~/_trash sits outside iCloud (only Desktop and Documents sync).
Concurrent runs are safe: choosing the name and moving happen under a lock on ~/_trash/<source>/.lock.
Runs on Apple's /usr/bin/python3 (3.9).
"""
from __future__ import annotations

import fcntl
import os
import shutil
import subprocess
import sys
from datetime import datetime

HOME = os.path.expanduser("~")
ROOT = os.environ.get("TRASH_ROOT", os.path.join(HOME, "_trash"))


def source_of(path: str) -> tuple[str, str]:
    """(source name, root folder the source's sub-paths are measured from)."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    try:
        out = subprocess.run(
            ["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        ).stdout.split("\n")
        if len(out) >= 2 and out[0] and out[1]:
            common, top = out[0].strip(), out[1].strip()
            # .../Repo/.git -> Repo; worktrees share the main repo's common dir.
            repo = os.path.dirname(common) if os.path.basename(common) == ".git" else common
            return os.path.basename(repo.rstrip("/")).removesuffix(".git") or "misc", top
    except (OSError, subprocess.SubprocessError):
        pass
    rel = os.path.relpath(path, HOME)
    if rel.startswith(".."):
        return "system", "/"
    first = rel.split(os.sep)[0]
    return first.lstrip(".") or "home", os.path.join(HOME, first)


def trash(path: str, source: str | None, now: datetime) -> str:
    src = os.path.abspath(os.path.expanduser(path)).rstrip("/")
    if not os.path.lexists(src):
        raise FileNotFoundError(src)
    if src == ROOT or src.startswith(ROOT + os.sep):
        raise ValueError(f"already in trash: {src}")
    if source is not None and (not source.strip(".") or "/" in source or ".." in source):
        raise ValueError(f"--source must be a plain folder name, not {source!r}")
    auto, top = source_of(src)
    name = source or auto
    # Keep the folders it came from: <source>/<date>/<sub/path/inside/source>.
    sub = os.path.relpath(os.path.dirname(src), top) if src != top else ""
    day = os.path.normpath(os.path.join(ROOT, name, now.strftime("%Y-%m-%d"), "" if sub.startswith("..") else sub))
    os.makedirs(day, exist_ok=True)
    with open(os.path.join(ROOT, name, ".lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # another trashmv must not pick the same free name before this move lands
        base = os.path.basename(src)
        dest = os.path.join(day, base)
        if os.path.lexists(dest):
            stem, ext = os.path.splitext(base) if os.path.isfile(src) else (base, "")
            tag = now.strftime("%H%M%S")
            dest, n = os.path.join(day, f"{stem} {tag}{ext}"), 2
            while os.path.lexists(dest):
                dest, n = os.path.join(day, f"{stem} {tag}-{n}{ext}"), n + 1
        shutil.move(src, dest)
        with open(os.path.join(ROOT, name, "moves.tsv"), "a") as log:
            log.write(f"{now.isoformat(timespec='seconds')}\t{src}\t{dest}\n")
    return dest


def main(argv: list[str]) -> int:
    source, paths, it = None, [], iter(argv)
    for a in it:
        if a == "--source":
            source = next(it, None)
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            paths.append(a)
    if not paths:
        print(__doc__, file=sys.stderr)
        return 2
    rc, now = 0, datetime.now()
    for p in paths:
        try:
            print(f"{p} -> {trash(p, source, now)}")
        except (OSError, ValueError) as e:
            print(f"trashmv: {e}", file=sys.stderr)
            rc = 1
    return rc


def test() -> None:
    import tempfile

    global ROOT, HOME
    env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t",
           "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t"}
    with tempfile.TemporaryDirectory() as t:
        t = os.path.realpath(t)
        HOME, ROOT = t, os.path.join(t, "_trash")
        repo = os.path.join(t, "Proj")
        subprocess.run(["git", "init", "-q", repo], check=True)
        subprocess.run(["git", "-C", repo, "commit", "-q", "--allow-empty", "-m", "x"], check=True, env=env)
        wt = os.path.join(repo, ".claude", "worktrees", "wt1")
        subprocess.run(["git", "-C", repo, "worktree", "add", "-q", wt], check=True, env=env)
        now = datetime(2026, 11, 14, 9, 30, 5)
        for p in (os.path.join(repo, "a.md"), os.path.join(wt, "a.md"), os.path.join(repo, "src", "old", "b.py")):
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "w").close()
        d1 = trash(os.path.join(repo, "a.md"), None, now)
        d2 = trash(os.path.join(wt, "a.md"), None, now)  # worktree -> same source; name clash
        d3 = trash(os.path.join(repo, "src", "old", "b.py"), None, now)  # keeps sub-folders
        assert d1 == os.path.join(ROOT, "Proj", "2026-11-14", "a.md"), d1
        assert d2 == os.path.join(ROOT, "Proj", "2026-11-14", "a 093005.md"), d2
        assert d3 == os.path.join(ROOT, "Proj", "2026-11-14", "src", "old", "b.py"), d3
        cfg = os.path.join(t, ".claude", "x.json")
        os.makedirs(os.path.dirname(cfg))
        open(cfg, "w").close()
        assert trash(cfg, None, now) == os.path.join(ROOT, "claude", "2026-11-14", "x.json")
        assert len(open(os.path.join(ROOT, "Proj", "moves.tsv")).readlines()) == 3
        for bad in ("../x", "a/b", "..", "."):
            try:
                trash(os.path.join(repo, "src"), bad, now)
                raise AssertionError(f"--source {bad!r} accepted")
            except ValueError:
                pass
        # concurrent runs: 8 threads trash 8 same-named files into one folder while each move is slowed
        # (widens the pick-a-free-name/move window); none may overwrite another
        import threading
        import time
        files = []
        for i in range(8):
            f = os.path.join(t, f"race{i}", "same.txt")  # top-level folders: all land in race/<date>/
            os.makedirs(os.path.dirname(f))
            with open(f, "w") as fh:
                fh.write(str(i))
            files.append(f)
        real_move = shutil.move
        shutil.move = lambda a, b: (time.sleep(0.05), real_move(a, b))[1]
        try:
            ths = [threading.Thread(target=trash, args=(f, "race", now)) for f in files]
            for th in ths:
                th.start()
            for th in ths:
                th.join()
        finally:
            shutil.move = real_move
        kept = [os.path.join(dp, n) for dp, _, ns in os.walk(os.path.join(ROOT, "race")) for n in ns
                if n.startswith("same")]
        assert sorted(open(k).read() for k in kept) == sorted(str(i) for i in range(8)), kept
    print("trashmv self-check: ok")


if __name__ == "__main__":
    if "--test" in sys.argv:
        test()
    else:
        sys.exit(main(sys.argv[1:]))
