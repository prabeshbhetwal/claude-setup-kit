{
  "rtk": {
    "hooks": [
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "type": "command",
        "command": "\"__RTK__\" hook claude",
        "match": "hook claude"
      }
    ]
  },
  "safety": {
    "hooks": [
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/block-rm.py\"",
        "timeout": 15,
        "match": "block-rm.py"
      },
      {
        "event": "SessionStart",
        "matcher": "",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/apply-hook-timeouts.py\" >/dev/null 2>&1 || true",
        "timeout": 15,
        "match": "apply-hook-timeouts.py"
      }
    ]
  },
  "indexes": {
    "hooks": [
      {
        "event": "SessionStart",
        "matcher": "",
        "type": "command",
        "command": "sh \"$HOME/.claude/hooks/ensure-indexes.sh\"",
        "match": "ensure-indexes.sh"
      },
      {
        "event": "Stop",
        "type": "command",
        "command": "sh \"$HOME/.claude/hooks/ensure-indexes.sh\" stop",
        "async": true,
        "match": "ensure-indexes.sh"
      },
      {
        "event": "UserPromptSubmit",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/codegraph-gate.py\"",
        "match": "codegraph-gate.py"
      },
      {
        "event": "PreToolUse",
        "matcher": "Grep|Glob|Bash|Read",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/index-first.py\" pre",
        "timeout": 15,
        "match": "index-first.py\" pre"
      },
      {
        "event": "PostToolUse",
        "matcher": "mcp__codegraph__.*|Edit|Write|MultiEdit",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/index-first.py\" post",
        "timeout": 15,
        "match": "index-first.py\" post"
      },
      {
        "event": "UserPromptSubmit",
        "matcher": null,
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/index-first.py\" prompt",
        "timeout": 15,
        "match": "index-first.py\" prompt"
      }
    ]
  },
  "routing": {
    "hooks": [
      {
        "event": "SessionStart",
        "matcher": "",
        "type": "command",
        "command": "sh \"$HOME/.claude/hooks/routing-card.sh\"",
        "match": "routing-card.sh"
      }
    ]
  },
  "cognee": {
    "env": {
      "COGNEE_BACKEND": "local"
    }
  },
  "jev": {
    "hooks": [
      {
        "event": "PostToolUse",
        "matcher": "Bash|Read|Grep|Glob|WebFetch|mcp__.*",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/jev-hooks.py\" tool-output",
        "timeout": 20,
        "async": true,
        "match": "jev-hooks.py\" tool-output"
      },
      {
        "event": "PostToolUse",
        "matcher": "mcp__.*__(search_threads|get_thread|get_message)",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/jev-hooks.py\" gmail",
        "timeout": 15,
        "async": true,
        "match": "jev-hooks.py\" gmail"
      },
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/jev-hooks.py\" pre-bash",
        "timeout": 15,
        "async": true,
        "match": "jev-hooks.py\" pre-bash"
      },
      {
        "event": "PreToolUse",
        "matcher": "Skill",
        "type": "command",
        "command": "\"$HOME/.local/bin/jev-gate\" --hook",
        "timeout": 20,
        "match": "jev-gate"
      },
      {
        "event": "SubagentStop",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/jev-hooks.py\" subagent-stop",
        "timeout": 15,
        "async": true,
        "match": "jev-hooks.py\" subagent-stop"
      }
    ]
  },
  "measure": {
    "hooks": [
      {
        "event": "Stop",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/token-ledger.py\"",
        "async": true,
        "timeout": 30,
        "match": "token-ledger.py"
      },
      {
        "event": "UserPromptSubmit",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/house-rules-recall.py\"",
        "timeout": 15,
        "match": "house-rules-recall.py"
      }
    ]
  },
  "guard": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f)"
    ]
  },
  "sandbox": {
    "settings": {
      "sandbox": {
        "enabled": true
      }
    }
  },
  "verify": {
    "hooks": [
      {
        "event": "PostToolUse",
        "matcher": "Edit|Write|MultiEdit",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/verify-done.py\" edit",
        "timeout": 90,
        "match": "verify-done.py\" edit"
      },
      {
        "event": "Stop",
        "type": "command",
        "command": "python3 \"$HOME/.claude/hooks/verify-done.py\" stop",
        "timeout": 660,
        "match": "verify-done.py\" stop"
      }
    ]
  }
}
