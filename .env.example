# claude-setup-kit: every key or sign-in the optional tiers use. NO VALUES HERE, and never commit real ones.
# The core tier needs none of these. Each line says where the value goes; this file itself is not read by anything.

# ---------------------------------------------------------------- memory tier
# Supermemory plugin. Optional: the plugin normally opens a browser sign-in on first use instead.
# Where: export in your shell profile, or the env block of ~/.claude/settings.json (that file is then a secret).
# Without it: Supermemory recall/save stays off until you sign in. Everything else works.
SUPERMEMORY_CC_API_KEY=

# Cognee (local). The local server sends captured conversation text to this LLM to build its graph.
# Optional: leave all three empty and Cognee runs on your Claude plan through the claude command (counts towards its usage limits).
# With a key it is paid per use on that provider's account instead. Set a monthly spend limit in its console.
# Where: ~/.cognee/.env (chmod 600).
# LLM_PROVIDER: e.g. anthropic
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ---------------------------------------------------------------- judge tier
# TypeSafe Jev (paid account). Used by jev, jev-gate, mjudge (PNG/JPG second opinion) and the shadow hooks.
# Where: macOS Keychain (hooks in the desktop app do not read ~/.zshrc):
#   security add-generic-password -s typesafe-api-key -a "$USER" -T '' -w   (-T '': macOS asks before any program reads it)
# or export TYPESAFE_API_KEY in your shell.
# Without it: jev exits 2 ("unavailable") and the hooks log a fail-open line; nothing blocks.
TYPESAFE_API_KEY=

# Gemini (free tier exists; free-tier inputs may be used for training). Used by mjudge.
# Where: ~/.config/watch/.env (chmod 600) or export GEMINI_API_KEY.
# Without it: mjudge cannot judge video/audio/PDF; images fall back to Jev only if that key exists.
GEMINI_API_KEY=

# ---------------------------------------------------------------- deliberation tier
# At least ONE provider. GPT and Gemini use their own CLI sign-ins, not keys:
#   GPT:    npm i -g @openai/codex && codex login      (ChatGPT account or OpenAI API)
#   Gemini: the agy CLI, signed in
# Grok and OpenRouter use keys. Where: shell profile, or the env block of ~/.claude/settings.json.
# Then run /deliberation:setup in Claude Code.
# Without any provider: the deliberation commands report "no provider"; everything else works.
XAI_API_KEY=
OPENROUTER_API_KEY=
